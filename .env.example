TELEGRAM_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
CONTEXT_WINDOW=15
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=50
REPLY_TIMEOUT=55
# optional: only if DuckDuckGo fails on Railway
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
SEARCH_MAX_RESULTS=5
SEARCH_RETRIES=2
# optional public SearXNG instance if DDG is rate-limited
# SEARXNG_URL=https://searx.example.com
# Railway sets RAILWAY_PUBLIC_DOMAIN → webhook mode automatically
# WEBHOOK_URL=https://your-service.up.railway.app
# WEBHOOK_PATH=vomitbot-webhook
# USE_POLLING=1
# USE_WEBHOOK=1
